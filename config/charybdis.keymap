// ═══════════════════════════════════════════════════════════════════════════════
//  Charybdis 4x6 – Keymap fusionné
//  • Config hardware  : keymapB (encodeurs, mmv, msc, zip scalers)
//  • Structure layers : keymapA (BASE / NAV / SYM / ADJ / SNIP / SCROLL)
//  • HRM              : hml / hmr balanced (meilleur que mt tap-preferred)
//  • Extras           : blt, ls_mclk, RGB dans ADJ, studio_unlock, combos
// ═══════════════════════════════════════════════════════════════════════════════

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// ─── Tuning trackball ─────────────────────────────────────────────────────────
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000   // vitesse deplacement curseur
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12     // vitesse scroll

// ─── Indices des layers ───────────────────────────────────────────────────────
#define BASE   0
#define NAV    1
#define SYM    2
#define ADJ    3
#define SNIP   4
#define SCROLL 5

// ─── Calibration trackball (depuis keymapB) ───────────────────────────────────
&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms  = <100>;
    delay-ms              = <0>;
};

&mmv {
    time-to-max-speed-ms  = <300>;
    acceleration-exponent = <1>;
    trigger-period-ms     = <16>;
};

// ─── Tuning global lt (layer-tap) ─────────────────────────────────────────────
&lt {
    tapping-term-ms = <200>;
    flavor          = "balanced";
    quick-tap-ms    = <150>;
};

/ {

    // ─── Comportements des encodeurs rotatifs (depuis keymapB) ───────────────
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    // ─── Behaviors personnalises ──────────────────────────────────────────────
    behaviors {

        // blt : layer-tap "tap-preferred" pour le cluster de pouces
        // -> tap = caractere, hold = layer momentane
        blt: blt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

        // hml : Home Row Mod - main GAUCHE
        // S'active uniquement quand une touche du cote DROIT est pressee,
        // ce qui evite les faux positifs en frappe rapide.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Positions cote droit : colonnes 6-11, toutes rangees + pouces droits
            hold-trigger-key-positions = <
                6  7  8  9  10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                42 43 44 45 46 47
                53 54 55
            >;
            hold-trigger-on-release;
        };

        // hmr : Home Row Mod - main DROITE
        // S'active uniquement quand une touche du cote GAUCHE est pressee.
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Positions cote gauche : colonnes 0-5, toutes rangees + pouces gauches
            hold-trigger-key-positions = <
                0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38 39 40 41
                48 49 50 51 52
            >;
            hold-trigger-on-release;
        };

    };

    // ─── Macros ───────────────────────────────────────────────────────────────
    macros {

        // ls_mclk : Shift + Middle Click
        // Utile pour ouvrir un lien dans un nouvel onglet (Shift+clic molette)
        ls_mclk: ls_mclk {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <10>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,   <&kp LSHIFT>,
                <&macro_tap>,     <&mkp MCLK>,
                <&macro_release>, <&kp LSHIFT>;
        };

    };

    // ─── Combos ───────────────────────────────────────────────────────────────
    combos {
        compatible = "zmk,combos";

        // ESC : Q + W ensemble (positions 13 + 14)
        combo_esc {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp ESC>;
        };

        // CAPS LOCK : LSHIFT + RSHIFT (positions 36 + 47)
        combo_caps {
            timeout-ms = <60>;
            require-prior-idle-ms = <200>;
            key-positions = <36 47>;
            bindings = <&kp CAPS>;
        };

        // Studio Unlock : 3 touches du pouce droit (53 + 54 + 55)
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <53 54 55>;
            bindings = <&studio_unlock>;
        };

    };

    // ─── Keymap ───────────────────────────────────────────────────────────────
    keymap {
        compatible = "zmk,keymap";

        // ══════════════════════════════════════════════════════════════════════
        // Layer 0 - BASE
        // QWERTY avec Home Row Mods (hml/hmr)
        //
        // Rangee principale gauche :  A=CTRL  S=ALT  D=GUI  F=SHIFT
        // Rangee principale droite :  J=SHIFT K=GUI  L=ALT  ;=CTRL
        // Z et / : layer-tap vers ADJ (maintenir = layer ADJ)
        // ══════════════════════════════════════════════════════════════════════
        //
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // | GRAVE  |   1    |   2    |   3    |   4    |   5    |  |   6    |   7    |   8    |   9    |   0    | MINUS  |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |  TAB   |   Q    |   W    |   E    |   R    |   T    |  |   Y    |   U    |   I    |   O    |   P    | EQUAL  |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |  ESC   | A/CTL  | S/ALT  | D/GUI  | F/SFT  |   G    |  |   H    | J/SFT  | K/GUI  | L/ALT  | ;/CTL  |   '    |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // | LSHFT  | Z[ADJ] |   X    |   C    |   V    |   B    |  |   N    |   M    |   ,    |   .    | /[ADJ] | RSHFT  |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        //          [lt(NAV)] [ BSPC ] [ LGUI ] [SPACE ] [ DEL  ]  [ ENTER ] [blt SYM] [mo ADJ]
        //
        BASE {
            display-name = "Base";
            bindings = <
&kp GRAVE   &kp N1        &kp N2       &kp N3        &kp N4         &kp N5      &kp N6   &kp N7         &kp N8         &kp N9        &kp N0           &kp MINUS
&kp TAB     &kp Q         &kp W        &kp E         &kp R          &kp T       &kp Y    &kp U          &kp I          &kp O         &kp P            &kp EQUAL
&kp ESC     &hml LCTRL A  &hml LALT S  &hml LGUI D   &hml LSHIFT F  &kp G       &kp H    &hmr RSHIFT J  &hmr RGUI K    &hmr RALT L   &hmr RCTRL SEMI  &kp APOS
&kp LSHIFT  &lt ADJ Z     &kp X        &kp C         &kp V          &kp B       &kp N    &kp M          &kp COMMA      &kp DOT       &lt ADJ SLASH    &kp RSHIFT
                          &lt NAV TAB  &kp BSPC      &kp LGUI       &kp SPACE   &kp DEL  &kp ENTER      &blt SYM SPACE &mo ADJ
            >;
            sensor-bindings = <&scroll_vertical_encoder>, <&scroll_horizontal_encoder>;
        };

        // ══════════════════════════════════════════════════════════════════════
        // Layer 1 - NAV
        // Navigation + Pave numerique + Touches de fonction F1-F12
        // ══════════════════════════════════════════════════════════════════════
        //
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |  F12   |   F1   |   F2   |   F3   |   F4   |   F5   |  |   F6   |   F7   |   F8   |   F9   |  F10   |  F11   |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |        | SCRLCK | PAUSE  |   up   |   =    |   {    |  |   }    |   7    |   8    |   9    |  KP+   |        |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // | PRTSCR |  INS   | left   |  down  | right  |   [    |  |   ]    |   4    |   5    |   6    |  KP-   |  KP/   |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |        |  DEL   | PG_UP  |  CAPS  | PG_DN  |   (    |  |   )    |   1    |   2    |   3    |  KP*   |        |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        //          [ (hold) ] [      ] [ VOL- ] [ VOL+ ] [      ]  [ KP_DOT] [   0   ] [mo ADJ]
        //
        NAV {
            display-name = "Nav";
            bindings = <
&kp F12          &kp F1          &kp F2           &kp F3             &kp F4           &kp F5      &kp F6    &kp F7    &kp F8  &kp F9  &kp F10          &kp F11
&trans           &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp UP             &kp EQUAL        &kp LBRC    &kp RBRC  &kp N7    &kp N8  &kp N9  &kp KP_PLUS      &trans
&kp PRINTSCREEN  &kp INSERT      &kp LEFT         &kp DOWN           &kp RIGHT        &kp LBKT    &kp RBKT  &kp N4    &kp N5  &kp N6  &kp KP_MINUS     &kp KP_DIVIDE
&trans           &kp DEL         &kp PG_UP        &kp CAPS           &kp PG_DN        &kp LPAR    &kp RPAR  &kp N1    &kp N2  &kp N3  &kp KP_MULTIPLY  &trans
                 &trans          &trans           &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans      &kp KP_DOT &kp N0  &mo ADJ
            >;
            sensor-bindings = <&scroll_vertical_encoder>, <&scroll_horizontal_encoder>;
        };

        // ══════════════════════════════════════════════════════════════════════
        // Layer 2 - SYM
        // Symboles de programmation organises logiquement par paires
        //   Rangee 1 : caracteres speciaux   ! @ # $ %  |  ^ & * ? '
        //   Rangee 2 : operateurs/groupants  + = ( )  " |  : [ ] { }
        //   Rangee 3 : comparaison/divers    < | - > \  |  ` _ / ~ ;
        // ══════════════════════════════════════════════════════════════════════
        //
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |  F12   |   F1   |   F2   |   F3   |   F4   |   F5   |  |   F6   |   F7   |   F8   |   F9   |  F10   |  F11   |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |        |   !    |   @    |   #    |   $    |   %    |  |   ^    |   &    |   *    |   ?    |   '    |        |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |        |   +    |   =    |   (    |   )    |   "    |  |   :    |   [    |   ]    |   {    |   }    |        |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |        |   <    |   |    |   -    |   >    |   \    |  |   `    |   _    |   /    |   ~    |   ;    |        |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        //          [mo ADJ ] [       ] [ VOL- ] [ VOL+ ] [      ]  [  C_FF ] [ C_PP  ] [ (hold)]
        //
        SYM {
            display-name = "Sym";
            bindings = <
&kp F12  &kp F1         &kp F2     &kp F3             &kp F4            &kp F5          &kp F6     &kp F7          &kp F8     &kp F9        &kp F10        &kp F11
&trans   &kp EXCL       &kp AT     &kp HASH           &kp DLLR          &kp PRCNT       &kp CARET  &kp AMPS        &kp STAR   &kp QUESTION  &kp SQT        &trans
&trans   &kp PLUS       &kp EQUAL  &kp LPAR           &kp RPAR          &kp DQT         &kp COLON  &kp LBKT        &kp RBKT   &kp LBRC      &kp RBRC       &trans
&trans   &kp LESS_THAN  &kp PIPE   &kp MINUS          &kp GREATER_THAN  &kp BACKSLASH   &kp GRAVE  &kp UNDERSCORE  &kp SLASH  &kp TILDE     &kp SEMICOLON  &trans
         &mo ADJ        &trans     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &trans          &kp C_FF   &kp C_PP        &trans
            >;
            sensor-bindings = <&scroll_vertical_encoder>, <&scroll_horizontal_encoder>;
        };

        // ══════════════════════════════════════════════════════════════════════
        // Layer 3 - ADJ
        // Bluetooth + Media + RGB + Systeme + Acces SNIP/SCROLL
        //
        // Cote gauche  : controles BT sortants, sys_reset, bootloader, RGB
        // Cote droit   : selection profils BT, boutons souris, sys_reset, bootloader
        // Rangee basse : acces momentane aux layers SNIP (4) et SCROLL (5)
        // ══════════════════════════════════════════════════════════════════════
        //
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |  F12   |   F1   |   F2   |   F3   |   F4   |   F5   |  |   F6   |   F7   |   F8   |   F9   |  F10   |  F11   |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |        |SYS_RST |BT_PRV  |BT_NXT  |BT_CLR  |OUT_TOG |  | BT_0   |BT_CLR  |BT_PRV  |BT_NXT  |SYS_RST |        |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |        | BOOT   | C_PRV  |  C_PP  | C_NXT  | C_MUTE |  | BT_1   |  MB1   |  MB2   |  MB3   |  BOOT  |        |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        // |        |RGB_TOG |RGB_BRD |RGB_BRI |RGB_EFF |RGB_SPD |  | BT_2   |        | mo SNIP|mo SCRL |        |        |
        // +--------+--------+--------+--------+--------+--------+  +--------+--------+--------+--------+--------+--------+
        //          [ (hold) ] [      ] [      ] [      ] [      ]  [       ] [       ] [ (hold)]
        //
        ADJ {
            display-name = "Adj";
            bindings = <
&kp F12  &kp F1           &kp F2          &kp F3            &kp F4           &kp F5           &kp F6        &kp F7      &kp F8      &kp F9      &kp F10      &kp F11
&trans   &sys_reset       &bt BT_PRV      &bt BT_NXT        &bt BT_CLR       &out OUT_TOG     &bt BT_SEL 0  &bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &sys_reset   &trans
&trans   &bootloader      &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT       &kp C_MUTE       &bt BT_SEL 1  &mkp MB1    &mkp MB2    &mkp MB3    &bootloader  &trans
&trans   &rgb_ug RGB_TOG  &rgb_ug RGB_BRD &rgb_ug RGB_BRI   &rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &bt BT_SEL 2  &trans      &mo SNIP    &mo SCROLL  &trans       &trans
         &trans           &trans          &trans            &trans           &trans           &trans        &trans      &trans
            >;
            sensor-bindings = <&scroll_vertical_encoder>, <&scroll_horizontal_encoder>;
        };

        // ══════════════════════════════════════════════════════════════════════
        // Layer 4 - SNIP
        // Mode sniping du trackball (mouvement lent et precis)
        // Toutes les touches sont transparentes sauf les boutons souris
        // et mo SCROLL pour basculer en scroll depuis ce layer
        // ══════════════════════════════════════════════════════════════════════
        SNIP {
            display-name = "Snip";
            bindings = <
&trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans    &trans
&trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans    &trans
&trans  &trans  &trans      &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3   &ls_mclk  &trans
&trans  &trans  &mo SCROLL  &trans  &trans  &trans  &trans  &trans    &trans    &mo SCROLL &trans    &trans
        &trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans
            >;
            sensor-bindings = <&scroll_vertical_encoder>, <&scroll_horizontal_encoder>;
        };

        // ══════════════════════════════════════════════════════════════════════
        // Layer 5 - SCROLL
        // Mode scroll du trackball
        // Le mouvement du trackball fait scroller la page au lieu de deplacer
        // le curseur. Boutons souris accessibles.
        // ══════════════════════════════════════════════════════════════════════
        SCROLL {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &ls_mclk  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans
            >;
            sensor-bindings = <&scroll_vertical_encoder>, <&scroll_horizontal_encoder>;
        };

    };
};
